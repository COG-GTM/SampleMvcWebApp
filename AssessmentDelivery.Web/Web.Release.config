<?xml version="1.0" encoding="utf-8"?>
<!-- Release build: on-prem IIS boxes. Ops replace the placeholders per server at deploy time. -->
<configuration xmlns:xdt="http://schemas.microsoft.com/XML-Document-Transform">
  <connectionStrings>
    <add name="AssessmentDelivery"
         connectionString="Data Source=__ONPREM_SQL_SERVER__,1433;Initial Catalog=AssessmentDelivery;User ID=ad_portal;Password=__ONPREM_SQL_PASSWORD__;MultipleActiveResultSets=True;Connect Timeout=30;Application Name=AssessmentDeliveryPortal"
         xdt:Transform="SetAttributes" xdt:Locator="Match(name)" />
  </connectionStrings>
  <appSettings>
    <add key="Portal.HostType" value="OnPrem" xdt:Transform="SetAttributes" xdt:Locator="Match(key)" />
    <add key="Portal.EnvironmentName" value="PROD" xdt:Transform="SetAttributes" xdt:Locator="Match(key)" />
  </appSettings>
  <system.web>
    <compilation xdt:Transform="RemoveAttributes(debug)" />
    <customErrors mode="RemoteOnly" xdt:Transform="Replace" />
  </system.web>
</configuration>
