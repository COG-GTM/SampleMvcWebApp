<?xml version="1.0" encoding="utf-8"?>
<!-- AzureRelease build: Azure App Service + Azure SQL. Password is substituted by the release pipeline. -->
<configuration xmlns:xdt="http://schemas.microsoft.com/XML-Document-Transform">
  <connectionStrings>
    <add name="AssessmentDelivery"
         connectionString="Server=tcp:&lt;your-server&gt;.database.windows.net,1433;Initial Catalog=AssessmentDelivery;Persist Security Info=False;User ID=ad_app;Password=__AZURE_SQL_PASSWORD__;MultipleActiveResultSets=True;Encrypt=True;TrustServerCertificate=False;Connection Timeout=30;"
         xdt:Transform="SetAttributes" xdt:Locator="Match(name)" />
  </connectionStrings>
  <appSettings>
    <add key="Portal.HostType" value="Azure" xdt:Transform="SetAttributes" xdt:Locator="Match(key)" />
    <add key="Portal.EnvironmentName" value="AZURE" xdt:Transform="SetAttributes" xdt:Locator="Match(key)" />
    <add key="Portal.BuildNumber" value="__BUILD_NUMBER__" xdt:Transform="SetAttributes" xdt:Locator="Match(key)" />
  </appSettings>
  <system.web>
    <compilation xdt:Transform="RemoveAttributes(debug)" />
    <customErrors mode="On" xdt:Transform="Replace" />
  </system.web>
</configuration>
