@model AssessmentDelivery.Web.Models.RescheduleViewModel
@{
    ViewBag.Title = "Reschedule Booking";
    ViewBag.Breadcrumb = "<a href=\"" + Url.Action("MyBookings", new { candidateNumber = Model.CandidateNumber }) + "\">My bookings</a> &raquo; Reschedule booking " + Model.Booking.BookingId;
}
<div class="nw-page-head">
    <h2>Reschedule booking <small>#@Model.Booking.BookingId</small></h2>
    <span class="nw-sub">Currently @Model.Booking.ExamCode at @Model.Booking.CenterName on @Model.Booking.StartsAt.ToString("dd MMM yyyy HH:mm") (@Model.Booking.Status)</span>
</div>
@using (Html.BeginForm("Reschedule", "Booking", new { id = Model.Booking.BookingId }, FormMethod.Post, new { @class = "nw-form" }))
{
    @Html.AntiForgeryToken()
    @Html.HiddenFor(m => m.CandidateNumber)
    @Html.ValidationSummary(false, "", new { @class = "alert alert-danger nw-alert" })
    <div class="nw-panel">
        <div class="nw-panel-heading">Other open sessions for @Model.Booking.ExamCode</div>
        <table class="table table-condensed table-striped nw-grid">
            <thead>
                <tr><th></th><th>Session</th><th>Centre</th><th>City</th><th>Room</th><th>Start</th><th class="num">Capacity</th><th class="num">Seats avail.</th><th>Status</th></tr>
            </thead>
            <tbody>
                @foreach (var s in Model.Targets)
                {
                    <tr>
                        <td><input type="radio" name="NewSessionId" value="@s.SessionId" id="s@(s.SessionId)" @(Model.NewSessionId == s.SessionId ? "checked" : "") /></td>
                        <td class="nw-muted"><label for="s@(s.SessionId)">#@s.SessionId</label></td>
                        <td>@s.CenterName</td>
                        <td>@s.City</td>
                        <td>@s.RoomName</td>
                        <td class="nowrap">@s.StartsAt.ToString("dd MMM yyyy HH:mm")</td>
                        <td class="num">@s.Capacity</td>
                        <td class="num @(s.SeatsAvailable == 0 ? "nw-zero" : "")">@s.SeatsAvailable</td>
                        <td>@Html.StatusPill(s.Status)</td>
                    </tr>
                }
                @if (Model.Targets.Count == 0)
                {
                    <tr><td colspan="9" class="nw-empty">No other open sessions for this exam.</td></tr>
                }
            </tbody>
        </table>
        <div class="nw-panel-body">
            <button type="submit" class="btn btn-primary btn-sm">Move booking</button>
            @Html.ActionLink("Back", "MyBookings", new { candidateNumber = Model.CandidateNumber }, new { @class = "btn btn-default btn-sm" })
        </div>
    </div>
}
