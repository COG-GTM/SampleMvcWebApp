<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <RootNamespace>ServiceLayer</RootNamespace>
    <AssemblyName>ServiceLayer</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- AutoMapper is pinned to 14.0.0: EfCore.GenericServices 10.0.0 is not compatible with
         AutoMapper 15.x (MethodAccessException on MapperConfiguration's ctor at runtime).
         This pin causes NU1903 (GHSA-rvv3-g6hj-g44x); see MIGRATION_NOTES.md section 4.3. -->
    <PackageReference Include="AutoMapper" Version="14.0.0" />
    <PackageReference Include="EfCore.GenericServices" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\BizLayer\BizLayer.csproj" />
    <ProjectReference Include="..\DataLayer\DataLayer.csproj" />
  </ItemGroup>

</Project>
