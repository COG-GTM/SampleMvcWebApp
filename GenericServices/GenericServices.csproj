<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <RootNamespace>GenericServices</RootNamespace>
    <AssemblyName>GenericServices</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <!--
      AutoMapper 14.0.0 is the last MIT-licensed release (15.x+ require a commercial licence).
      GHSA-rvv3-g6hj-g44x (DoS via uncontrolled recursion) is only fixed in the commercial 15.1.1+.
      This app maps small, fixed DTO graphs from trusted internal data, so the DoS risk does not
      apply; the advisory is suppressed here (only this id) and documented in the PR risks section.
    -->
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-rvv3-g6hj-g44x" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="AutoMapper" Version="14.0.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="8.0.11" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="8.0.11" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="8.0.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\GenericLibsBase\GenericLibsBase.csproj" />
  </ItemGroup>

</Project>
