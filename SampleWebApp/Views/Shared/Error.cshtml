@model SampleWebApp.Models.ErrorViewModel

@{
    ViewBag.Title = "Error";
}

<h1 class="text-danger">Error.</h1>
<h2 class="text-danger">An error occurred while processing your request.</h2>

@if (Model != null && Model.StatusCode != null)
{
    <p>Http status code @Model.StatusCode.</p>
}

@if (Model != null && Model.ShowRequestId)
{
    <p class="small text-muted">Request Id: <code>@Model.RequestId</code></p>
}
