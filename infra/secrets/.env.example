# Copy to infra/secrets/.env (git-ignored). Stand-in for the secrets manager (Vault / Key Vault).
# Key NAMES are part of the app's runtime contract — the app fails to start if a key it expects is missing.

# SQL Server SA password (db container bootstrap + db-init)
MSSQL_SA_PASSWORD=Str0ng!Passw0rd

# App -> DB. Legacy ASP.NET app reads this into Web.config <connectionStrings name="SampleWebAppDb">.
SAMPLEWEBAPP_DB_CONNECTION=Server=db.svc.internal,1433;Database=SampleWebAppDb;User Id=sa;Password=Str0ng!Passw0rd;MultipleActiveResultSets=True

# reporting/ -> DB (least-privilege login created by infra/db/01-schema.sql)
REPORTING_DB_PASSWORD=Rep0rting!Passw0rd

# Grafana admin
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=admin
